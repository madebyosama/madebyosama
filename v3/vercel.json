{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/zoom",
      "destination": "https://app.zoom.us/wc/3988095546/start?fromPWA=1&ref_from=launch&pwd=bkhtRlNxL3E3SnZCTU1oSFNHcHJNQT09",
      "permanent": false
    },
    {
      "source": "/meet",
      "destination": "https://meet.google.com/zxw-ioiv-mwk",
      "permanent": false
    },
    {
      "source": "/instagram",
      "destination": "https://www.instagram.com/madebyosama/",
      "permanent": false
    },
    {
      "source": "/facebook",
      "destination": "https://www.facebook.com/madebyosama/",
      "permanent": false
    },
    {
      "source": "/x",
      "destination": "https://www.x.com/madebyosama/",
      "permanent": false
    },
    {
      "source": "/linkedin",
      "destination": "https://www.linkedin.com/in/madebyosama/",
      "permanent": false
    },
    {
      "source": "/figma",
      "destination": "https://www.figma.com/@madebyosama",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://www.github.com/madebyosama/",
      "permanent": false
    }
  ]
}
